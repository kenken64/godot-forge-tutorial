# Proxy listener. Ollama clients connect to http://127.0.0.1:8788
PORT=8788

# Codex CLI backend
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_SANDBOX=read-only
# Directory Codex is allowed to inspect.
CODEX_CWD=.
CODEX_TIMEOUT_MS=300000

# Optional. If set, clients must send Authorization: Bearer <value>.
PROXY_API_KEY=

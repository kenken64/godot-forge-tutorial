# Copy to .env on the AWS Lightsail instance. Never commit .env.
GODOT_CLOUD_DOMAIN=godot.kere.com
GODOT_CLOUD_APP_ORIGIN=https://learn-game.kere.com
GODOT_CLOUD_DATA_ROOT=/srv/godot-forge-cloud/data
GODOT_CLOUD_SHARED_SECRET=replace-with-a-long-random-secret
GODOT_CLOUD_MAX_SESSIONS=1
GODOT_CLOUD_IDLE_MINUTES=45

# Text/design requests are forwarded server-side to the Ollama-compatible proxy.
OLLAMA_PROXY_URL=http://127.0.0.1:8788
# Set only if the proxy uses PROXY_API_KEY.
OLLAMA_PROXY_API_KEY=

# Optional OpenAI image and storyline voice configuration.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TTS_MODEL=gpt-4o-mini-tts
